generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  plan           String           @default("BASIC")
  leadLimit      Int              @default(1000)
  createdAt      DateTime         @default(now())
  users          User[]
  pipelineStages PipelineStage[]
  customers      Customer[]
  automations    Automation[]
  notifications  Notification[]
}

model User {
  id                String         @id @default(cuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  email             String
  passwordHash      String
  role              String         @default("SALES_REP")
  active            Boolean        @default(true)
  callsMade         Int            @default(0)
  contactsReached   Int            @default(0)
  conversions       Int            @default(0)
  createdAt         DateTime       @default(now())
  assignedCustomers Customer[]     @relation("AssignedRep")
  messages          Message[]
  tasks             Task[]
  activities        Activity[]
  notifications     Notification[]

  @@unique([companyId, email])
  @@index([companyId, role])
}

model PipelineStage {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  color     String     @default("#64748b")
  position  Int
  customers Customer[]

  @@unique([companyId, slug])
  @@index([companyId, position])
}

model Customer {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  assignedUserId String?
  assignedUser   User?         @relation("AssignedRep", fields: [assignedUserId], references: [id])
  name           String
  phone          String?
  email          String?
  grade          String?
  source         String        @default("OTHER")
  notes          String?
  tags           String        @default("[]")
  revenue        Float         @default(0)
  lastActivityAt DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       Message[]
  tasks          Task[]
  activities     Activity[]

  @@index([companyId, stageId])
  @@index([companyId, assignedUserId])
  @@index([companyId, source])
  @@index([companyId, lastActivityAt])
}

model Message {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id])
  type       String   @default("TEXT")
  content    String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model Activity {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  type       String
  summary    String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model Task {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId String
  assignee   User     @relation(fields: [assigneeId], references: [id])
  title      String
  dueAt      DateTime
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@index([companyId, dueAt])
  @@index([assigneeId, status])
}

model Automation {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  triggerType  String
  triggerValue String?
  actionType   String
  actionValue  String?
  enabled      Boolean @default(true)
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}
