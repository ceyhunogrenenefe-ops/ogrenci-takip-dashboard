{
  "name": "@crm/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "build": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "bcryptjs": "^2.4.3",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
